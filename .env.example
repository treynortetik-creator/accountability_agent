# The Warden - Environment Variables
# Copy this to .env and fill in your values

# App Settings
DEBUG=false

# API Authentication
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secure-api-key-here

# Telegram Bot
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your-telegram-chat-id
# Your deployed webhook URL (Railway will provide this)
TELEGRAM_WEBHOOK_URL=https://your-app.railway.app/webhook/telegram

# OpenRouter API
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# Cheap model options: google/gemini-flash-1.5, openai/gpt-4o-mini, anthropic/claude-3-haiku
OPENROUTER_MODEL=google/gemini-flash-1.5

# Database (SQLite - no config needed for local, but you can customize path)
DATABASE_URL=sqlite+aiosqlite:///./warden.db

# Timezone
TIMEZONE=America/Phoenix

# Schedule (24-hour format)
DAILY_CHECKIN_HOUR=4
DAILY_CHECKIN_MINUTE=15
WEEKLY_REVIEW_DAY=sun
WEEKLY_REVIEW_HOUR=18
WEEKLY_REVIEW_MINUTE=0

# Escalation Settings
SILENCE_THRESHOLD_HOURS=18
DEADLINE_ALERT_HOURS=48
